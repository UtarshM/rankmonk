# ==============================================================================
# RankMonk.ai — SaaS Platform Environment Variables
# ==============================================================================

# ─── 1. Supabase Configuration (Database, Auth & Realtime) ─────────────────────
# Create a free project at https://supabase.com
# Execute schema.sql in Supabase SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── 2. AWS Bedrock AI Hosting (Primary Intelligence Provider) ─────────────────
# Required for Claude 3.5 Sonnet / Haiku / Llama 3 / Amazon Nova on AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Optional: Session token if using temporary STS credentials
# AWS_SESSION_TOKEN=...
# Optional Bedrock model ID override (defaults to Claude 3.5 Sonnet)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Alternative models:
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
# AWS_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ─── 3. Fallback AI Provider (Optional) ───────────────────────────────────────
# Secondary fallback if AWS Bedrock credentials are not present
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# ─── 4. Application Security & Runtime Configuration ─────────────────────────
NODE_ENV=production
PORT=3000
WORKER_SECRET=rankmonk-worker-secret-key-change-me

# ─── 5. Production Host URL (Vercel or AWS) ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://rankmonk.vercel.app
